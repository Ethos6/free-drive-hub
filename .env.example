# Public address people use to open Drive Hub (no trailing slash).
# Must match the redirect URI in Google Cloud: <BASE_URL>/oauth/google/callback
DRIVEHUB_BASE_URL=http://localhost:8080

# OAuth client from Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Encrypts saved Google sign-ins. If empty, a random key is created in
# the data folder (data/secret.key). Back it up together with data/drivehub.db.
DRIVEHUB_SECRET_KEY=

# Set to 1 only when running behind a reverse proxy you control (Caddy, nginx,
# Cloudflare Tunnel), so login rate limiting sees the real client address.
DRIVEHUB_TRUST_PROXY=0
